{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SkinnyNote Skin",
  "type": "object",
  "required": [
    "id",
    "name",
    "productName",
    "colors",
    "uiFont",
    "editorFont",
    "extraCss"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "number": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "colors": {
      "type": "object",
      "required": [
        "statusFg",
        "menuFg",
        "aboutFg",
        "aboutButtonFg"
      ],
      "properties": {
        "panel": {
          "type": "string"
        },
        "panel2": {
          "type": "string"
        },
        "button": {
          "type": "string"
        },
        "titleBg": {
          "type": "string"
        },
        "titleFg": {
          "type": "string"
        },
        "editorBg": {
          "type": "string"
        },
        "editorFg": {
          "type": "string"
        },
        "statusBg": {
          "type": "string"
        },
        "statusFg": {
          "type": "string"
        },
        "menuFg": {
          "type": "string"
        },
        "menuHoverBg": {
          "type": "string"
        },
        "menuHoverFg": {
          "type": "string"
        },
        "aboutFg": {
          "type": "string"
        },
        "aboutButtonFg": {
          "type": "string"
        },
        "selectionBg": {
          "type": "string"
        },
        "selectionFg": {
          "type": "string"
        },
        "hi": {
          "type": "string"
        },
        "mid": {
          "type": "string"
        },
        "dark": {
          "type": "string"
        },
        "deep": {
          "type": "string"
        },
        "frameBg": {
          "type": "string"
        },
        "grip": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "uiFont": {
      "type": "string"
    },
    "editorFont": {
      "type": "string"
    },
    "editorWeight": {
      "type": [
        "string",
        "number"
      ]
    },
    "defaultFontSize": {
      "type": "number"
    },
    "fontRevision": {
      "type": "number"
    },
    "extraCss": {
      "type": "string"
    },
    "skinnyNote": {
      "type": "object",
      "properties": {
        "icon": {
          "type": "object"
        },
        "titleBarLines": {
          "type": "object"
        },
        "about": {
          "type": "object"
        }
      }
    }
  }
}
